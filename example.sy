int main() {
    int x = 42;      // 变量 x 被赋值，但从未使用
    int y = 100;     // 变量 y 被赋值并被使用
    int z = x + y;   // 计算 z 的值，但 z 的结果未被使用
    return y;        // 返回 y 的值
