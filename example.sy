int main()
{
    int n = 1;
    int i = 0;
    int S = 0;
    int S2 = 0;
    while(i < n){
        S = S + i;
        i = i + 1;
    }

    i = 0;
    while(i < 10){
        S2 = S2 + i;
        i = i + 1;
    }
    putint(S2);
    putch(10);
    return 0;
}
